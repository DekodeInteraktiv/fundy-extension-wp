#. Plugin Name of the plugin
#: dekode-fundraising.php:3
#: inc/settings-page-network.php:40
#: inc/settings-page.php:48
msgid "Dekode Fundraising"
msgstr "Dekode Fundraising"

#. Plugin URI of the plugin
#: dekode-fundraising.php:4
msgid "https://github.com/DekodeInteraktiv/fundy-extension-wp/"
msgstr "https://github.com/DekodeInteraktiv/fundy-extension-wp/"

#. Description of the plugin
#: dekode-fundraising.php:5
msgid "Integrates with Dekode Fundraising, making it easy to add donation forms to your website."
msgstr "Integrerer med Dekode Fundraising og gjør det enkelt å legge til donasjonsskjemaer på nettstedet ditt."

#. Author of the plugin
#: dekode-fundraising.php:7
msgid "Dekode Interaktiv"
msgstr "Dekode Interaktiv"

#. Author URI of the plugin
#: dekode-fundraising.php:8
msgid "https://dekode.no"
msgstr "https://dekode.no"

#. translators: placeholder 1 is minimum required PHP version, placeholder 2 is installed PHP version.
#: dekode-fundraising.php:94
#, php-format
msgid "Dekode Fundraising plugin requires PHP %1$s or higher. You are still on %2$s."
msgstr "Dekode Fundraising-utvidelsen krever PHP %1$s eller nyere. Du bruker fortsatt %2$s."

#. translators: placeholder 1 is minimum required WordPress version, placeholder 2 is installed WordPress version.
#: dekode-fundraising.php:103
#, php-format
msgid "Dekode Fundraising plugin requires at least WordPress in version %1$s, You are on %2$s."
msgstr "Dekode Fundraising-utvidelsen krever minst WordPress versjon %1$s. Du bruker %2$s."

