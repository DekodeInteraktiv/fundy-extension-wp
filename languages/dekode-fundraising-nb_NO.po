#: inc/settings-page-network.php:430
#: inc/settings-page.php:636
msgid "Prevents pushing any conversion events to the dataLayer, including the purchase event."
msgstr "Hindrer at konverteringshendelser sendes til dataLayer, inkludert purchase-hendelsen."

#: inc/settings-page-network.php:450
#: inc/settings-page.php:657
msgid "Prevents pushing the form funnel events (view_item, add_to_cart, remove_from_cart, begin_checkout, add_payment_info) to the dataLayer. The purchase event still fires."
msgstr "Hindrer at skjemaets trakthendelser (view_item, add_to_cart, remove_from_cart, begin_checkout, add_payment_info) sendes til dataLayer. Purchase-hendelsen sendes fortsatt."

