#. translators: %s: error message returned while fetching the organization.
#: inc/settings-page.php:300
#, php-format
msgid "The organization ID could not be fetched (%s). Save the settings again to retry."
msgstr "Organisasjons-ID-en kunne ikke hentes (%s). Lagre innstillingene på nytt for å prøve igjen."

#. translators: %s: error message returned while fetching the theme list.
#: inc/settings-page.php:350
#, php-format
msgid "The stylesheet URL for the selected theme could not be resolved (%s). Save the settings again to retry."
msgstr "Stilark-URL-en for det valgte temaet kunne ikke hentes (%s). Lagre innstillingene på nytt for å prøve igjen."

