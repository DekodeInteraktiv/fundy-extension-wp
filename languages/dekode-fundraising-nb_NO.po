msgid "Override network settings?"
msgstr "Overstyre nettverksinnstillingene?"

#: inc/settings-page.php:409
msgid "Enter your API key"
msgstr "Skriv inn API-nøkkelen din"

#: inc/settings-page.php:445
msgid "Managed in the network settings."
msgstr "Styres i nettverksinnstillingene."

#: inc/settings-page.php:450
msgid "Save an API key to get the kiosk link."
msgstr "Lagre en API-nøkkel for å få kiosklenken."

#. translators: %s: error message returned while fetching the organization.
#: inc/settings-page.php:460
#, php-format
msgid "The kiosk link could not be fetched (%s). Reload the page to retry."
